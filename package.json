{
  "name": "finger-frame-3d-avatar",
  "version": "1.0.0",
  "description": "Real-time browser finger-frame AR with locally driven cartoon avatars",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": "y6821552",
  "homepage": "https://y6821552.github.io/finger-frame-3d-avatar/",
  "repository": {
    "type": "git",
    "url": "https://github.com/y6821552/finger-frame-3d-avatar.git"
  },
  "keywords": [
    "mediapipe",
    "threejs",
    "face-tracking",
    "hand-tracking",
    "webgl",
    "avatar",
    "augmented-reality"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-runtime-assets.mjs",
    "prepare:assets": "node scripts/prepare-runtime-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@pixiv/three-vrm": "^3.5.5",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sparticuz/chromium": "^149.0.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "eslint": "^10.8.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
